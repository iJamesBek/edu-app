# Public origin of the site. Drives canonical URLs, hreflang, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://it-shaharcha.uz

# Leave empty to use built-in mock data (src/lib/mock.ts).
# Set to the backend base URL to switch data source, e.g. https://api.example.uz/v1
EDU_API_URL=

# Disable Next.js telemetry in CI / Vercel builds too (local machine already opted out)
NEXT_TELEMETRY_DISABLED=1
